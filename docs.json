{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Doughmination Docs",
  "colors": {
    "primary": "#eb459e",
    "light": "#eb459e",
    "dark": "#eb459e"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/media/favicon.jpg",
  "logo": {
    "light": "/media/favicon.jpg",
    "dark": "/media/favicon.jpg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Welcome",
        "pages": [
          "index",
          "faq"
        ]
      },
      {
        "group": "Sandrone",
        "icon": "/media/sandrone.png",
        "root": "sandrone",
        "pages": [
          "sandrone/commands",
          "sandrone/setup",
          "sandrone/official-links",
          "sandrone/downloads",
          "sandrone/flags",
          "sandrone/units",
          "sandrone/errors",
          "sandrone/development",
          "sandrone/tos",
          "sandrone/privacy"
        ]
      },
      {
        "group": "pkviewer",
        "icon": "/media/pkviewer.svg",
        "root": "pkviewer",
        "pages": [
          "pkviewer/claiming",
          "pkviewer/addresses",
          "pkviewer/appearance",
          "pkviewer/badges",
          "pkviewer/css",
          "pkviewer/privacy"
        ]
      },
      {
        "group": "JPCL",
        "icon": "https://raw.githubusercontent.com/jpcl-lang/assets/refs/heads/main/png/icon.png",
        "root": "jpcl",
        "pages": [
          "jpcl/start",
          "jpcl/syntax",
          "jpcl/recipes",
          "jpcl/py",
          "jpcl/npm",
          "jpcl/go",
          "jpcl/cli",
          "jpcl/errors",
          "jpcl/spec"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Discord",
        "href": "https://discord.gg/N8gCjS294R"
      },
      {
        "label": "Matrix",
        "href": "https://matrix.to/#/#doughmination:matrix.org"
      }
    ]
  },
  "search": {
    "prompt": "Search"
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/doughmination",
      "discord": "https://discord.gg/N8gCjS294R"
    },
    "links": [
      {
        "header": "Community",
        "items": [
          {
            "label": "Matrix",
            "href": "https://matrix.to/#/#doughmination:matrix.org"
          }
        ]
      }
    ]
  }
}
